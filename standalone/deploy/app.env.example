# Copy outside the repository; mode 0600. Replace every placeholder before service startup.
PORT=4310
CQA_SOURCE_INSTANCE=wpstchroma
CQA_SNAPSHOT_PATH=/var/lib/chroma-qa/imports/REPLACE_WITH_SHA.snapshot.json
CQA_SNAPSHOT_SHA256=REPLACE_WITH_VERIFIED_PAYLOAD_SHA256
CQA_DATABASE_PATH=/var/lib/chroma-qa/app.sqlite
CQA_GRANTS_PATH=/etc/chroma-qa/grants.json
CQA_AUDIT_PATH=/var/log/chroma-qa/access.audit.jsonl
CQA_PROXY_SECRET=REPLACE_WITH_RANDOM_SECRET_FROM_SECRET_MANAGER
CQA_PUBLIC_ORIGIN=https://REPLACE_WITH_APPROVED_QA_HOST
CQA_CHECKLIST_PATH=/etc/chroma-qa/reviewed-checklists.json
CQA_CHECKLIST_SHA256=REPLACE_WITH_REVIEWED_FILE_SHA256
CQA_MEDIA_DIRECTORY=/var/lib/chroma-qa/media
CQA_PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
CQA_WRITES_ENABLED=false
